  "=== REFERENCIA: COLOURS ===": "normal_bg, hovered_bg, disabled_bg, selected_bg, active_bg, dark_bg | normal_text, hovered_text, disabled_text, selected_text, active_text | normal_border, hovered_border, disabled_border, selected_border, active_border | text_cursor (incluye alpha: #RRGGBBaa) | filled_bar, unfilled_bar (para barras de progreso)",

  "=== REFERENCIA: MISC ===": "shape: 'rectangle' | 'rounded_rectangle' | 'ellipse' --- shape_corner_radius: '4' (px, solo rounded_rectangle) --- border_width: '1' (px) --- shadow_width: '2' (px, 0 para desactivar) --- padding: '5,5' (horiz,vert) --- text_horiz_alignment: 'left'|'centre'|'right' --- text_vert_alignment: 'top'|'centre'|'bottom' --- text_horiz_alignment_padding: '10' --- text_shadow_size: '0' --- text_shadow_offset: '0,0'",

  "=== REFERENCIA: FONT ===": "name: nombre de fuente del sistema (ej 'arial', 'verdana') --- size: tamaño en puntos como string (ej '16') --- bold: '1' activo, '0' desactivo --- italic: '1' activo, '0' desactivo --- antialiased: '1' activo",

  "=== REFERENCIA: OBJECT_IDs ===": "Se declaran en el widget con object_id='#mi_id'. En el theme se usan como clave directa '#mi_id'. Para targeting compuesto: 'tipo_widget.#mi_id' o '#id_padre.tipo_hijo'. Ejemplo: '#panel_control.label' afecta todos los UILabel dentro del panel con id #panel_control.",

  "=== WIDGETS USADOS EN ESTE PROYECTO ===": "label → UILabel (lbl_campo, lbl_status, lbl_panel_title, lbl_titulo_panel, lbl_valor) | text_entry_line → UITextEntryLine (campos v0, angle, wind) | button → UIButton (btn_continuar, btn_menos, btn_mas) | panel → UIPanel (panel_control)"
}
